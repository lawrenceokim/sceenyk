# Copy to .env.workers.ugc. Reuse the approved app/worker models and limits.
# Enabling OpenAI can spend real funds on already queued jobs.
UGC_V3_OPENAI_ENABLED=0
OPENAI_API_KEY=
OPENAI_V3_IMAGE_MODEL=
OPENAI_V3_DIRECTOR_MODEL=
# Paid video is independently disabled. Keep real-funded caps/consent intact.
UGC_V3_HIGGSFIELD_ENABLED=0
UGC_V3_HIGGSFIELD_CREDENTIALS=
UGC_V3_HIGGSFIELD_ACCOUNT_SCOPE=
UGC_V3_HIGGSFIELD_OUTPUT_HOSTS=
# If currently used, copy the verified limits JSON to an ignored local file and
# add a read-only runtime bind mount; set this to its CONTAINER path.
UGC_V3_HIGGSFIELD_LIMITS_FILE=
