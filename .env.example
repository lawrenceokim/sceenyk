# Clerk DEVELOPMENT instance only. Copy to .env.local and supply real test keys.
# Public browser key: starts with pk_test_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only secret: starts with sk_test_; never use NEXT_PUBLIC_ for this key.
CLERK_SECRET_KEY=

# New Supabase DEVELOPMENT project; application data only, not Supabase Auth.
# These values are server-only. No NEXT_PUBLIC_ database key is required.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional legacy alternative to SUPABASE_SECRET_KEY (service_role JWT only).
# SUPABASE_SERVICE_ROLE_KEY=
