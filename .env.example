# Clerk DEVELOPMENT instance only. Copy to .env.local and supply real test keys.
# Public browser key: starts with pk_test_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only secret: starts with sk_test_; never use NEXT_PUBLIC_ for this key.
CLERK_SECRET_KEY=

# New Supabase DEVELOPMENT project; application data only, not Supabase Auth.
# These values are server-only. No NEXT_PUBLIC_ database key is required.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional legacy alternative to SUPABASE_SECRET_KEY (service_role JWT only).
# SUPABASE_SERVICE_ROLE_KEY=

# Private Cloudflare R2 DEVELOPMENT bucket; every value below is server-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional temporary single-PUT safeguard in bytes; defaults to 104857600.
# Product limits are undecided. Cannot exceed the provider single-PUT ceiling.
# MEDIA_MAX_UPLOAD_BYTES=104857600

# Current UGC development: fail closed to local-only job execution.
# Missing/invalid values also mean local-only, including in a local next start.
# Blocks ALL Inngest ingress/SDK transport and non-loopback media-worker calls.
# Keep 1 throughout UGC development. Only explicitly approved later hosted work
# may set 0; this does not implement or activate a UGC local runner.
SCEENYK_LOCAL_JOBS_ONLY=1

# Preserved legacy Inngest Cloud credentials (never NEXT_PUBLIC_).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional during signing-key rotation only:
# INNGEST_SIGNING_KEY_FALLBACK=
# Historical legacy option only; blocked while SCEENYK_LOCAL_JOBS_ONLY=1.
# UGC V1 does not use Inngest, including its local Dev Server.
# Local legacy development only: INNGEST_DEV=1 alongside the local Dev Server.
# Production always forces signature verification, even with this opt-in set.
# INNGEST_DEV=1

# Optional SERVER-ONLY JSON retail rules for explicitly labeled development/test
# credit quotes. No default rates; omit to leave paid generation unavailable.
# See context/pricing.md for the schema. Never use this as production pricing.
# SCEENYK_TEST_PRICING_JSON=
# Optional server-only paid-credit warning threshold (default 25). UI only;
# never triggers a charge or changes generation eligibility.
# SCEENYK_LOW_CREDIT_THRESHOLD=25
# UGC M4: private local-worker Responses image analysis only. No default model.
# Set an image-input + strict Structured Outputs capable Responses model manually.
OPENAI_API_KEY=
OPENAI_REFERENCE_ANALYSIS_MODEL=
# Explicit manual opt-in before starting worker:ugc. Calls can incur provider cost.
UGC_REFERENCE_ANALYSIS_ENABLED=1
# Future stages; not consumed yet.
# UGC_AI_PROVIDER=openai
# UGC_OPENAI_TEXT_MODEL=
# UGC_OPENAI_IMAGE_MODEL=
# UGC_VIDEO_PROVIDER=
# UGC_VIDEO_MODEL=

# Legacy Freestyle Gemini planning only; never UGC V1. Optional model override.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Active fal visual scenes; server-only, never NEXT_PUBLIC_.
FAL_KEY=
# ElevenLabs narration; SERVER-ONLY, configured on the Render media worker.
# Never set NEXT_PUBLIC_ELEVENLABS_API_KEY. No key is needed to reuse saved audio.
ELEVENLABS_API_KEY=
# Central approved model override; defaults to stable narration Multilingual v2.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Separate authenticated Node/FFmpeg preparation worker; never a public key.
# Legacy hosted orchestration never executes FFmpeg inside Next.js.
# Current local-only guard rejects hosted origins even when configured below.
# For a later explicitly requested local media run, use http://127.0.0.1:3012.
# Retain the hosted URL privately for later review; do not start work now.
MEDIA_WORKER_URL=
WORKER_SHARED_SECRET=
# Same random >=32-character shared secret on Render and Vercel.
# MEDIA_WORKER_URL is the HTTPS origin, without /prepare. No bearer fallback.
# Replaces MEDIA_PREPARATION_WORKER_URL / MEDIA_PREPARATION_WORKER_TOKEN.
# Render supplies PORT automatically; it takes precedence over the local port.
# Worker-only settings; Linux/Docker can use installed /usr/bin binaries.
# MEDIA_PREPARATION_WORKER_PORT=3012
# MEDIA_PREPARATION_WORKER_HOST=127.0.0.1
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Reviewed endpoints only; explicit adapters/capabilities required for new models.
# FAL_TEXT_MODEL=lightricks/ltx-2.5/text-to-video/fast
# FAL_IMAGE_MODEL=lightricks/ltx-2.5/image-to-video/fast
# FAL_VIDEO_MODEL=fal-ai/ltx-2.3-quality/reference-video-to-video
# Infrastructure estimates/safeguards, never customer pricing.
# FAL_PRICING_VERSION=fal-reviewed-2026-10-12
# FAL_VIDEO_SECOND_USD=0.09
# FAL_TRANSFORM_MEGAPIXEL_USD=0.0024075
# FAL_MAX_SCENE_SECONDS=6
# FAL_MAX_SCENE_USD=1.5
# FAL_MAX_JOB_USD=3

# Optional INACTIVE legacy Runway adapter; not needed by the active workflow.
# RUNWAYML_API_SECRET=
# Reviewed models only; no automatic fallback.
# RUNWAY_TEXT_MODEL=gen4.5
# RUNWAY_IMAGE_MODEL=gen4_turbo
# RUNWAY_VIDEO_MODEL=aleph2
# Infrastructure cost safeguards, not customer credit prices.
# RUNWAY_MAX_SCENE_SECONDS=5
# RUNWAY_MAX_SCENE_USD=1.5
# RUNWAY_MAX_JOB_USD=3

# UGC M5 Character Sheet: private credentials, explicit local paid-call opt-in.
# Obtain key ID + secret from Higgsfield Console; never use NEXT_PUBLIC_.
# Separate fields: HF_API_KEY_SECRET is the secret ONLY, never KEY_ID:SECRET.
# The adapter adds the single "Key " prefix and ID:secret separator.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HIGGSFIELD_SOUL2_CHARACTER_MODEL=higgsfield-ai/soul/v2/image-to-image
## Character V5: reuse a completed existing Soul ID, or off for image-only parity.
## Never creates a new paid identity. Default: reuse. Recorded on each request.
UGC_CHARACTER_V5_SOUL_ID_MODE=reuse
UGC_CHARACTER_SHEET_ENABLED=0
# Comma-separated EXACT output CDN hostnames from Higgsfield documentation/support.
# Required before starting worker:ugc; no arbitrary hosts, URLs or wildcards.
# Or review images[].url hostnames in an authenticated completed SOUL2 API test.
# cdn.example.com in the docs is a placeholder, not an approved output host.
# Keep empty until verified; bootstrap outside worker:ugc, never bypass validation.
# Offline extraction/manual steps: context/character-sheet.md
HIGGSFIELD_OUTPUT_HOSTS=
# Polling only; no callback/webhook/public localhost tunnel is required.

# UGC M6 Product Sheet: Image Edit API; reuses private OPENAI_API_KEY above.
# Separate paid-call opt-in. Does not enable hosted execution or change Character.
OPENAI_PRODUCT_SHEET_MODEL=gpt-image-2.5-sunburst
UGC_PRODUCT_SHEET_ENABLED=0

# UGC M7 Location: independent local-worker opt-in; explicit Generate Location
# queues automatic private planning + image generation. No hosted execution.
# Reuses private OPENAI_API_KEY. Plan model must support Responses structured outputs.
# Empty plan model falls back to OPENAI_REFERENCE_ANALYSIS_MODEL.
UGC_LOCATION_ENABLED=0
OPENAI_LOCATION_PLAN_MODEL=
OPENAI_LOCATION_IMAGE_MODEL=gpt-image-2.5-sunburst
# Optional private durable local directory, shared by the app and local worker.
# Empty uses the OS temp directory / sceenyk-location-recovery-v1. Keep it stable
# across restarts; this stores recovery PNG bytes, never browser-visible files.
UGC_LOCATION_RECOVERY_DIR=

# UGC M8 Storyboard: independent local-worker opt-in, never automatic generation.
# Set an explicitly reviewed vision-capable Responses structured-output model.
# No fallback; the selected model freezes on first submission for a storyboard.
UGC_STORYBOARD_ENABLED=0
OPENAI_STORYBOARD_MODEL=
# Optional explicit provider-side response retention for GET recovery (30+ days
# under OpenAI retention policy). Default 0 preserves store:false privacy.
# Changing this cannot make an old store:false response retrievable.
UGC_STORYBOARD_STORE_RESPONSES=0
# Optional private durable local directory; retain across worker restarts.
# Empty uses OS temp / sceenyk-storyboard-recovery-v1 (may be cleared by the OS).
UGC_STORYBOARD_RECOVERY_DIR=

# PayPal SANDBOX ONLY, server-only. Live is rejected by code.
# Register the Sandbox app webhook at /api/payments/paypal/webhook first.
# See context/payments.md for events, migration and real acceptance.
# PAYPAL_ENVIRONMENT=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Trusted app origin for approval/cancel returns (HTTPS, or localhost HTTP).
PAYPAL_RETURN_ORIGIN=
# Enable only after the Sandbox Payouts capability and required webhook events
# are manually verified. See context/payments.md. Never enables PayPal Live.
# SCEENYK_PAYPAL_PAYOUTS_ENABLED=sandbox-confirmed
# Sandbox/demo holding policy only (60–86400 seconds, default 300).
# Frozen per original sale on first assignment; never a production policy.
# SCEENYK_MARKETPLACE_TEST_SETTLEMENT_SECONDS=300
